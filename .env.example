# Copy to .env.local for local development. Never commit real values.

# Database connection.
#   pglite://.data/dev   embedded PostgreSQL (PGlite) stored in ./.data/dev - zero setup, single process.
#   pglite://memory      in-memory PostgreSQL, used by automated tests.
#   postgres://user:pass@host:5432/db   a real PostgreSQL server (required in production).
DATABASE_URL=pglite://.data/dev

# Secret used by Better Auth to sign session cookies. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public base URL of the app (no trailing slash). Used for auth callbacks and share links.
BETTER_AUTH_URL=http://localhost:3000

# How long an "Explore demo" sandbox lives before it is cleaned up, in hours.
DEMO_TTL_HOURS=24

# Set to "true" to require TLS when DATABASE_URL points at a managed PostgreSQL that needs it
# and the connection string does not already include sslmode.
DATABASE_SSL=false

# Maximum database connections per server instance (PostgreSQL only). Keep low on serverless hosts.
DATABASE_POOL_MAX=5

# Optional, for `npm run db:seed` only: the local sample account it creates.
# If SEED_USER_PASSWORD is empty, a random password is generated and printed once.
SEED_USER_EMAIL=owner@campaignlens.test
SEED_USER_PASSWORD=

# Optional, for tests only: run `npm test` against a PostgreSQL server instead of in-memory PGlite.
# TEST_DATABASE_URL=postgres://campaignlens:campaignlens@localhost:5432/campaignlens_test
